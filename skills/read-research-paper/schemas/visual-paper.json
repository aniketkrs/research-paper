{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-paper/skills/read-research-paper/schemas/visual-paper.json",
  "title": "Visual Paper",
  "description": "Structured representation of a fetched + parsed paper, ready to render into paper-visual.md.",
  "type": "object",
  "required": ["canonical_id", "title", "authors", "year"],
  "properties": {
    "canonical_id": {
      "type": "string",
      "description": "e.g., 'arxiv:2403.01234', 'doi:10.1145/3589334', 'url:<sha256>', 'text:<sha256>'."
    },
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["family"],
        "properties": {
          "family": { "type": "string" },
          "given": { "type": "string" },
          "affiliation": { "type": "string" },
          "is_organization": { "type": "boolean", "default": false }
        }
      }
    },
    "year": { "type": "integer" },
    "venue": { "type": "string" },
    "doi": { "type": "string" },
    "arxiv_id": { "type": "string" },
    "url": { "type": "string", "format": "uri" },
    "abstract": { "type": "string" },
    "keywords": {
      "type": "array",
      "items": { "type": "string" }
    },

    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "text"],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "abstract", "introduction", "background", "related-work",
              "method", "experiments", "results", "discussion",
              "limitations", "conclusion", "future-work",
              "references", "appendix", "custom"
            ]
          },
          "title": { "type": "string" },
          "text": { "type": "string" },
          "subsections": {
            "type": "array",
            "items": { "$ref": "#/properties/sections/items" }
          },
          "inferred_from_text": { "type": "boolean", "default": false }
        }
      }
    },

    "figures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["number", "caption"],
        "properties": {
          "number": { "type": "integer", "minimum": 1 },
          "caption": { "type": "string" },
          "extractable": { "type": "boolean", "default": false },
          "file": { "type": "string" },
          "described_in_section": { "type": "string" }
        }
      }
    },

    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["number", "caption"],
        "properties": {
          "number": { "type": "integer", "minimum": 1 },
          "caption": { "type": "string" },
          "headers": { "type": "array", "items": { "type": "string" } },
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": ["string", "number", "null"] }
            }
          },
          "file": { "type": "string" },
          "markdown": { "type": "string" }
        }
      }
    },

    "headline_numbers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["value", "metric", "context"],
        "properties": {
          "value": { "type": ["string", "null"] },
          "metric": { "type": "string" },
          "context": { "type": "string" },
          "direction": { "type": "string", "enum": ["increase", "decrease", "neutral"] },
          "confidence_interval": { "type": ["string", "null"] },
          "p_value": { "type": ["string", "null"] },
          "effect_size": { "type": ["string", "null"] },
          "source_section": { "type": "string" },
          "importance_rank": { "type": "integer", "minimum": 1, "maximum": 5 }
        }
      }
    },

    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cite_key": { "type": "string" },
          "authors": { "type": "array" },
          "year": { "type": "integer" },
          "title": { "type": "string" },
          "venue": { "type": "string" },
          "doi": { "type": "string" },
          "url": { "type": "string" },
          "raw": { "type": "string" },
          "parse_confidence": { "type": "string", "enum": ["high", "medium", "low"] }
        }
      }
    },

    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    },

    "contribution_list": {
      "type": "array",
      "items": { "type": "string" }
    },

    "visuals_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": [
              "mind-map", "method-flowchart", "key-findings-infographic",
              "comparison-table", "related-work-timeline", "concept-map",
              "author-network", "figure-passthrough"
            ]
          },
          "section": { "type": "string" },
          "renderer": { "type": "string", "enum": ["mermaid", "matplotlib", "markdown"] },
          "file": { "type": "string" },
          "caption": { "type": "string" }
        }
      }
    },

    "plain_english_layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["section_id", "summary", "walkthrough"],
        "properties": {
          "section_id": { "type": "string" },
          "summary": { "type": "string" },
          "walkthrough": { "type": "string" },
          "analogy": { "type": "string" },
          "why_it_matters": { "type": "string" },
          "flesch_kincaid_grade": { "type": "number" }
        }
      }
    },

    "cache_metadata": {
      "type": "object",
      "properties": {
        "version": { "type": "integer" },
        "fetched_at": { "type": "string", "format": "date-time" },
        "source": {
          "type": "string",
          "enum": ["live-fetch", "cache", "bundled-corpus", "model-knowledge"]
        },
        "skill_version": { "type": "string" },
        "verification_trail": {
          "type": "object",
          "properties": {
            "doi_resolves": { "type": ["boolean", "null"] },
            "crossref_match": { "type": ["boolean", "null"] },
            "retraction_check": {
              "type": "string",
              "enum": ["clean", "retracted", "not-checked"]
            },
            "arxiv_confirmed": { "type": ["boolean", "null"] },
            "checked_at": { "type": "string", "format": "date-time" }
          }
        },
        "etag_or_hash": { "type": "string" }
      }
    },

    "incomplete_fields": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
