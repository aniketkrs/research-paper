{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-paper-writer/schemas/citation-schema.json",
  "title": "Bibliography Entry",
  "description": "Canonical metadata for a single bibliographic reference. The citation pipeline projects this into any output style.",
  "type": "object",
  "required": ["id", "type", "authors", "year", "title"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$",
      "description": "Cite key, e.g. 'smith_2023_llm'."
    },
    "type": {
      "type": "string",
      "enum": [
        "article-journal",
        "article-conference",
        "book",
        "chapter",
        "report",
        "webpage",
        "dataset",
        "thesis",
        "preprint",
        "standard",
        "patent",
        "personal-communication",
        "software"
      ]
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["family"],
        "properties": {
          "family": { "type": "string" },
          "given": { "type": "string" },
          "is_organization": { "type": "boolean", "default": false }
        }
      }
    },
    "editors": {
      "type": "array",
      "items": { "$ref": "#/properties/authors/items" }
    },
    "year": { "type": "integer", "minimum": 1500, "maximum": 2100 },
    "month": { "type": "integer", "minimum": 1, "maximum": 12 },
    "day": { "type": "integer", "minimum": 1, "maximum": 31 },
    "title": { "type": "string", "minLength": 3 },
    "container": {
      "type": "string",
      "description": "Journal, book, or proceedings title."
    },
    "volume": { "type": ["integer", "string"] },
    "issue": { "type": ["integer", "string"] },
    "pages": { "type": "string", "description": "e.g. '12-34' or '1-37'" },
    "publisher": { "type": "string" },
    "address": { "type": "string", "description": "Publisher city for books." },
    "edition": { "type": ["integer", "string"] },
    "doi": { "type": "string", "pattern": "^10\\..+/.+" },
    "url": { "type": "string", "format": "uri" },
    "isbn": { "type": "string" },
    "issn": { "type": "string" },
    "arxiv_id": { "type": "string", "pattern": "^\\d{4}\\.\\d{4,5}(v\\d+)?$|^[a-z\\-]+/\\d{7}$" },
    "pmid": { "type": "string" },
    "report_number": { "type": "string" },
    "thesis_type": {
      "type": "string",
      "enum": ["PhD", "MSc", "BSc", "Habilitation", "MPhil", "Other"]
    },
    "institution": { "type": "string" },
    "accessed": { "type": "string", "format": "date" },
    "language": { "type": "string", "default": "en" },
    "notes": { "type": "string" },
    "verification": {
      "type": "string",
      "enum": ["verified", "unverified-offline", "unverified", "retracted"],
      "default": "unverified"
    },
    "quality_score": {
      "type": "object",
      "properties": {
        "authority": { "type": "integer", "minimum": 0, "maximum": 4 },
        "rigor": { "type": "integer", "minimum": 0, "maximum": 3 },
        "recency": { "type": "integer", "minimum": 0, "maximum": 3 },
        "total": { "type": "integer", "minimum": 0, "maximum": 10 }
      }
    },
    "uncertain_fields": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Fields the model is not confident about — must be verified before submission."
    },
    "incomplete_fields": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Required-by-type fields missing — paper cannot be considered submission-ready until filled."
    }
  }
}
